# Copy to backend/.env and fill in. The repo-root .env.local / .env.prod files carry
# the same keys and are what start-kummo.sh reads.

# --- Supabase Auth (GoTrue) ---
# Identity only. Application data no longer goes through PostgREST.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_API_KEY=<anon key — public by design>

# --- Database ---
# Runtime connection, as the DML-only kummo_app role. The only database URL the
# backend needs: DDL is done by the Supabase CLI, which uses its own connection.
# Percent-encode reserved characters in the password (@ -> %40).
DATABASE_URL=postgresql+asyncpg://kummo_app:<password>@127.0.0.1:54322/postgres

# --- Sessions ---
# Where this app is served. Used to build the OAuth callback URL and to decide where
# to send the browser after a provider redirect.
APP_BASE_URL=http://localhost:8000
# Session cookies are HttpOnly always; set true wherever the app is served over TLS.
COOKIE_SECURE=false

# --- Static site (optional) ---
# Absolute path to the directory served at /. Defaults to the repo's static/, so a
# source checkout needs nothing here; the container image sets it to /app/static.
# STATIC_DIR=/app/static

# --- Google sign-in (optional) ---
# Read by `supabase start`, not by the backend. Create an OAuth client in the Google
# Cloud console with http://127.0.0.1:54321/auth/v1/callback as the authorized redirect
# URI. Without these, /api/auth/oauth/google returns an error from the auth server;
# email + password registration works regardless.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Logging ---
# Root log level: DEBUG, INFO, WARNING, ERROR. DEBUG is loud — SQLAlchemy and httpx
# both talk at that level.
LOG_LEVEL=INFO
